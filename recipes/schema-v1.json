{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olduvai-jp/gpu-run/recipes/schema-v1.json",
  "title": "gpu-run recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "image", "inputs", "requirements", "transfers", "stages", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "image": {"type": "string", "pattern": "^[a-z0-9./_-]+@sha256:[0-9a-f]{64}$"},
    "inputs": {
      "type": "object", "additionalProperties": {"$ref": "#/$defs/input"}
    },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["gpus", "min_vram_gb", "disk_gb", "cuda"],
      "properties": {
        "gpus": {"type": "integer", "minimum": 1},
        "min_vram_gb": {"type": "integer", "exclusiveMinimum": 0},
        "allowed_gpu_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "disk_gb": {"type": "integer", "exclusiveMinimum": 0},
        "cuda": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "env": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}, "uniqueItems": true}
      }
    },
    "transfers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["input", "remote_path"], "properties": {"input": {"type": "string"}, "remote_path": {"type": "string", "pattern": "^[a-zA-Z0-9._/-]+$"}}}},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "argv"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "working_dir": {"type": "string"}, "env_from": {"type": "array", "items": {"type": "string"}}, "timeout": {"type": "string"}}}},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "kind", "remote_path", "required"], "properties": {"name": {"type": "string"}, "kind": {"enum": ["file", "directory"]}, "remote_path": {"type": "string"}, "required": {"type": "boolean"}, "when": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean", "enum", "file", "directory", "https_url", "hf_ref"]},
        "required": {"type": "boolean"}, "secret": {"type": "boolean"}, "default": {}, "allowed": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "extensions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
